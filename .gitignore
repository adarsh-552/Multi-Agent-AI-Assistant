```gitignore
# Environment and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]

# Uploaded and generated data
uploads/
vectorstore/
memory.json

# Streamlit config: keep config.toml, ignore secrets
.streamlit/*
!.streamlit/config.toml
.streamlit/secrets.toml

# IDE
.vscode/
.idea/

# Generated documents
*.docx

# OS files
.DS_Store
Thumbs.db
```
